# LLM Provider Configuration (OpenRouter recommended)
LLM_PROVIDER=openrouter

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini-2024-07-18
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Agentic RAG Chatbot
# OPENROUTER_SITE_URL=https://your-site-url.com

# Optional: Direct OpenAI API Configuration
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Application Settings
APP_NAME=Agentic RAG Chatbot
APP_VERSION=1.0.0
DEBUG=False

# Database
CHROMA_PERSIST_DIRECTORY=./data/chromadb

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Agent Settings
MAX_ITERATIONS=8
TEMPERATURE=0.3
MAX_TOKENS=1000

# Web Search Configuration
WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-YOUR_API_KEY
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_MAX_RESULTS=5
# ZENSERP_API_KEY=your_zenserp_api_key_here

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app
# Optional: allow Vercel preview domains
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
