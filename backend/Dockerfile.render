FROM python:3.11-slim

WORKDIR /app

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install dependencies with CPU-only torch (much smaller)
RUN pip install --no-cache-dir -r requirements.txt && \
    pip uninstall -y torch torchvision torchaudio && \
    pip install torch --index-url https://download.pytorch.org/whl/cpu --no-cache-dir

# Copy application
COPY . .

# Create directories
RUN mkdir -p data/chromadb data/uploads

EXPOSE 8000

# Use gunicorn with single worker for memory efficiency
CMD ["gunicorn", "main:app", \
     "--workers", "1", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--max-requests", "100", \
     "--max-requests-jitter", "10", \
     "--preload"]
